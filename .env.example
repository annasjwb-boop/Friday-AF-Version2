# Mapbox token. Required for the homepage map — without it the page falls
# back to the SVG silhouette rather than breaking.
#
# Vite inlines this at build time, so it ends up in the JS bundle regardless.
# Keeping it out of source only stops it being scraped from the public repo;
# what actually protects it is a URL restriction set on the token in the
# Mapbox account. Add one before this is deployed anywhere public.
VITE_MAPBOX_TOKEN=

# Optional. Defaults to the project's custom style
# (mapbox://styles/argtlsj85/cmjesqgz3001y01s1gx990dix).
# VITE_MAPBOX_STYLE=
