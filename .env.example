# Mapbox. Without a token the Florida map falls back to the SVG silhouette,
# so the page still renders — it just loses the real basemap.
#
# Create a public token (pk.…) at https://account.mapbox.com/access-tokens/
# and restrict it by URL before using it anywhere public.
VITE_MAPBOX_TOKEN=

# Optional. Any Mapbox style URL — swap this to restyle the basemap without
# touching code. Defaults to Mapbox Light.
# VITE_MAPBOX_STYLE=mapbox://styles/mapbox/light-v11
